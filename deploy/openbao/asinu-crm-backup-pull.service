[Unit]
Description=Copy CRM ciphertext off its VPS using a restricted SSH identity
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/asinu-openbao/pull-crm-backup.py --config /etc/asinu/crm-backup-pull/config.json
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/asinu-crm-offhost
